{
  "name": "nest-next-auth",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/passport-jwt": "^4.0.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@nestjs/config": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "jose": "^6.2.12",
    "passport-jwt": "^4.0.1",
    "zod": "^4.6.5"
  }
}
